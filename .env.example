# ---- Swastik Polymers — Supabase connection ----
# Copy this file to .env.local and fill in your own Supabase project values.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# SERVER ONLY — never prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

SUPABASE_JWKS_URL=https://YOUR-PROJECT-ref.supabase.co/auth/v1/.well-known/jwks.json
INQUIRY_RATE_LIMIT_PER_HOUR=20
